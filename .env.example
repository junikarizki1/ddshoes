# ================================================================
# DD Shoes — Environment Variables untuk Coolify Production
# Salin file ini menjadi .env untuk development lokal
# Isi semua nilai di bawah ini di Coolify Environment Variables
# ================================================================

# Django Core
# Buat secret key baru dengan: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-very-long-random-secret-key-here-minimum-50-chars

# Set ke False untuk production, True untuk development lokal
DEBUG=False

# Domain/IP yang boleh akses aplikasi (pisahkan dengan koma, tanpa spasi)
# Contoh: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Origin HTTPS yang diizinkan untuk CSRF (harus pakai https://)
# Contoh: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ================================================================
# Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Di Coolify: buat PostgreSQL service, lalu copy connection string-nya
# ================================================================
DATABASE_URL=postgres://ddshoes_user:your-db-password@your-db-host:5432/ddshoes

# ================================================================
# Pembayaran — Midtrans
# Dapatkan dari: https://dashboard.midtrans.com → Settings → Access Keys
# ================================================================
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxx
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxx

# ================================================================
# Email — Gmail SMTP
# Gunakan App Password (bukan password akun Gmail biasa)
# Cara buat App Password: https://myaccount.google.com/apppasswords
# ================================================================
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ================================================================
# Shipping — Komerce / RajaOngkir
# Dapatkan dari: https://app.komerce.id → API Settings
# ================================================================
KOMERCE_API_KEY=your-komerce-api-key

# ================================================================
# Site URL (untuk link di email broadcast, tanpa trailing slash)
# Contoh: https://ddshoes.com
# ================================================================
SITE_URL=https://yourdomain.com

# ================================================================
# Media Storage (opsional — hanya ubah jika path volume berbeda)
# Default: /app/media (sesuai Coolify persistent volume mount point)
# ================================================================
# MEDIA_ROOT=/app/media
